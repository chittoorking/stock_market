# ═══ CAM BOT v3 — Live Trading Environment ═══

# Upstox API (get from https://account.upstox.com/developer/apps)
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:5000/callback

# Capital (in Rs)
CAPITAL=100000

# Data paths
DATA_DIR=/app/data/5min
JOURNAL_DIR=/app/journal
TOKEN_FILE=/app/data/upstox_token.txt
