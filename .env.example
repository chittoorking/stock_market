# ─── Application ───
APP_NAME=Trading AI Agent
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ─── LLM Accounts (multi-account pool with round-robin load balancing) ───
ACCOUNT_1_API_KEY=sk-...
ACCOUNT_1_GPT4O_RPM_LIMIT=500
ACCOUNT_1_GPT4O_TPM_LIMIT=150000
ACCOUNT_2_API_KEY=sk-...
ACCOUNT_2_GPT4O_RPM_LIMIT=500
ACCOUNT_2_GPT4O_TPM_LIMIT=150000

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/trading_bot
REDIS_URL=redis://localhost:6379/0

# ─── Broker: Zerodha Kite ───
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=

# ─── Broker: Alpaca (US markets) ───
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── Broker: CCXT (Crypto) ───
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=

# ─── Risk Limits ───
MAX_POSITION_SIZE=100000
MAX_PORTFOLIO_EXPOSURE=500000
MAX_LEVERAGE=2.0
DEFAULT_STOP_LOSS_PCT=3.0
DEFAULT_TAKE_PROFIT_PCT=10.0
MAX_DAILY_LOSS=25000
MAX_OPEN_POSITIONS=10

# ─── Market Data ───
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_WS_URL=

# ─── Notifications ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=trading-bot@yourdomain.com

# ─── Session ───
SESSION_TTL_SECONDS=3600
SIGNAL_TTL_SECONDS=900

# ─── Auth ───
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
